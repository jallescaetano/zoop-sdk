{
    "name": "church/communication-system",
    "description": "Sistema de comunicação para igrejas via WhatsApp",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Church\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8000 -t public"
    },
    "config": {
        "optimize-autoloader": true
    }
}
